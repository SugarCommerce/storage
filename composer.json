{
  "name": "sugarcommerce/storage",
  "description": "Files on disk for WordPress: protected upload folders with local delivery, safe paths, MIME types, filenames and download names, streamed zips, and upload inspection.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/SugarCommerce/storage",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/plugin": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Storage\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/SugarCommerce/storage/issues",
    "source": "https://github.com/SugarCommerce/storage"
  },
  "keywords": [
    "wordpress",
    "downloads",
    "file-delivery",
    "x-sendfile",
    "htaccess",
    "mime-types",
    "filenames",
    "content-disposition",
    "zip",
    "upload-inspection"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Storage\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
