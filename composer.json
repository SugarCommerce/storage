{
  "name": "sugarcommerce/storage",
  "description": "Files and object storage for WordPress: S3-compatible signing, uploads and listings, an admin bucket browser, protected upload folders with local delivery, safe paths, MIME types and filenames, streamed zips, upload inspection, and the cache, cleanup and cast helpers.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/storage",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/plugin": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Storage\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/storage/issues",
    "source": "https://github.com/sugarcommerce/storage"
  },
  "keywords": [
    "wordpress",
    "s3",
    "sigv4",
    "presigned-url",
    "cloudflare-r2",
    "object-storage",
    "multipart-upload",
    "media-browser",
    "downloads",
    "file-delivery",
    "htaccess",
    "mime-types",
    "zip",
    "transients"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Storage\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "test:js": "node tests/js/upload.js",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
